# Bland AI API key for your organization
# Get from: https://www.bland.ai/app/keys
BLAND_API_KEY=sk-bland-...

# Per-org keys for the web dashboard. Each org row names the env var holding
# its key (eval_orgs.bland_api_key_env); BLAND_API_KEY is the fallback.
BLAND_API_KEY_TEXANS=sk-bland-...
BLAND_API_KEY_COMPUGEN=sk-bland-...

# OpenRouter API key for LLM judge grading
# Get from: https://openrouter.ai
# Used to grade agent responses using DeepSeek model
OPENROUTER_API_KEY=sk-or-...
